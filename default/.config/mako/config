# Catppuccin Mocha
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#cba6f7
progress-color=over #45475a
border-size=2
border-radius=10
padding=12
font=MesloLGS Nerd Font 10
icon-path=/usr/share/icons/breeze-dark:/usr/share/icons/breeze

# niri hardcodes a "Screenshot captured" notification on every capture
# (no config option as of 26.04). Hide it; satty opening is feedback enough.
# Expire it too: mako ignores the transient hint and defaults to no timeout,
# so hidden notifications would otherwise pile up in the list forever.
[app-name=niri summary="Screenshot captured"]
invisible=1
default-timeout=1000
history=0

[urgency=critical]
border-color=#f38ba8
ignore-timeout=1
default-timeout=0
on-button-left=dismiss

# Firefox web notifications carry no app_icon, so draw a glyph in the message.
# A web app that ships an icon via image-data still matches (mako criteria
# cannot see image-data) and shows its real icon plus this glyph. Order is
# priority: the Slack rule below overrides this format.
[desktop-entry=firefox app-icon=""]
format=<span foreground="#FF7139">󰈹</span> <b>%s</b>\n%b

# Slack in a tab reports desktop-entry=firefox, so the summary is the only
# discriminator (fragile: any site using "New message ..." too).
[desktop-entry=firefox summary~="^New message (from|in) " app-icon=""]
format=<span foreground="#E01E5A">󰒱</span> <b>%s</b>\n%b

# cod-claude U+EC82
[desktop-entry=com.anthropic.Claude app-icon=""]
format=<span foreground="#D97757"></span> <b>%s</b>\n%b
