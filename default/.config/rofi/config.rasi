configuration {
  // Start in fuzzy (first entry); Ctrl+= / Ctrl+- (kb-matcher-up/down) cycles
  // the listed matchers at runtime. Rofi defaults (Super+=/-) conflict with
  // niri column resizing, so use Ctrl+=/- instead.
  matching: "fuzzy,normal,prefix,regex";
  kb-matcher-up: "Control+equal";
  kb-matcher-down: "Control+minus";
  // niri-menu: go up one menu level (rofi custom keybinding 1)
  kb-custom-1: "Control+t";
  kb-select-1: "Control+1";
  kb-select-2: "Control+2";
  kb-select-3: "Control+3";
  kb-select-4: "Control+4";
  kb-select-5: "Control+5";
  kb-select-6: "Control+6";
  kb-select-7: "Control+7";
  kb-select-8: "Control+8";
  kb-select-9: "Control+9";
  kb-select-10: "Control+0";
}
