// -*- mode: jsonc -*-
// Optional waybar widget, toggled by waybar-optional (niri-menu > Waybar).
// Enabling symlinks this file into ~/.config/waybar/modules/, which
// config.jsonc globs into its includes; custom/agent-berth must stay
// listed in a modules-* array there.
{
  "custom/agent-berth": {
    "exec-if": "command -v agent-berth",
    "exec": "$HOME/.config/waybar/agent-berth.sh",
    "return-type": "json",
    "interval": 5,
    // Detach: waybar waitpids the click command before the next poll.
    "on-click": "setsid -f kitty --class tui-popup agent-berth tui",
    "on-click-right": "setsid -f kitty --class tui-popup aiusage --bar"
  }
}
