// -*- mode: jsonc -*-
{
  "layer": "top",
  "position": "top",
  "height": 20,
  "spacing": 4,
  "modules-left": [
    "niri/workspaces",
    "cffi/niri-taskbar"
  ],
  "modules-center": [
    "niri/window"
  ],
  "modules-right": [
    "idle_inhibitor",
    // Optional widget: fragment in waybar/optional/, toggled by waybar-optional (niri-menu > Waybar)
    "custom/agent-berth",
    "pulseaudio",
    "network",
    "power-profiles-daemon",
    "load",
    "cpu",
    "memory",
    "temperature",
    // "niri/language",
    "clock",
    "tray",
    "custom/hyprwhspr",
    "custom/menu"
  ],
  "niri/workspaces": {
    "format": "{icon} {value}",
    "format-icons": {
      "urgent": " ",
      "focused": " ",
      "default": " ",
      "empty": "•"
    }
  },
  "cffi/niri-taskbar": {
    "module_path": "/opt/niri-taskbar/libniri_taskbar.so",
    "only_current_workspace": true
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "tray": {
    "icon-size": 20,
    "spacing": 10
  },
  "clock": {
    "tooltip-format": "<big>{:%b %d, %a}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%m/%d}"
  },
  "load": {
    "format": "{load1}",
    "interval": 5,
    "on-click": "setsid -f kitty --class tui-popup btop"
  },
  "cpu": {
    "format": "{usage}% ",
    "states": {
      "warning": 70,
      "critical": 90
    },
    "on-click": "setsid -f kitty --class tui-popup btop"
  },
  "memory": {
    "format": "{}% ",
    "states": {
      "warning": 70,
      "critical": 90
    },
    "on-click": "setsid -f kitty --class tui-popup btop"
  },
  "temperature": {
    "critical-threshold": 80,
    "warning-threshold": 60,
    "format": "{temperatureC}°C {icon}",
    "format-icons": [
      "",
      "",
      ""
    ],
    "on-click": "setsid -f kitty --class tui-popup btop"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "network": {
    "format-wifi": "{essid} ({signalStrength}%) ",
    "format-ethernet": "{ipaddr}/{cidr} ",
    "tooltip-format": "{ifname} via {gwaddr} ",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "Disconnected ⚠",
    "format-alt": "{ifname}: {ipaddr}/{cidr}",
    "on-click-right": "setsid -f kitty --class clash -d ~/codebase/clashd/ tmux-up"
  },
  "pulseaudio": {
    "format": "{volume}% {icon} {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " {format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "tooltip-format": "<b>Output</b>\n{desc} ({volume}%)\n<b>Input</b>\n{source_desc} ({source_volume}%)",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "setsid -f pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },
  "custom/menu": {
    "format": "\uF313 ",
    "tooltip": false,
    "on-click": "setsid -f niri-menu",
    "on-click-right": "setsid -f niri-menu Niri"
  },
  // Optional widgets are fragments in waybar/optional/ (dotfiles repo);
  // waybar-optional symlinks the enabled ones into modules/ (agent-status
  // defines custom/agent-berth above)
  "include": [
    "$HOME/.config/waybar/hyprwhspr-module.jsonc",
    "$HOME/.config/waybar/modules/*.jsonc"
  ]
}
