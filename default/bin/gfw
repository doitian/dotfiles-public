#!/usr/bin/env bash

set -e
set -u
[ -n "${DEBUG:-}" ] && set -x || true

if [ -z "${http_proxy:-}" ]; then
  PROXY_PROTOCOL="${PROXY_PROTOCOL:-http}"
  PROXY_HOST="${PROXY_HOST:-127.0.0.1}"
  PROXY_PORT="${PROXY_PORT:-7890}"

  if nc -z "$PROXY_HOST" "$PROXY_PORT" &>/dev/null; then
    :
  elif ping -c1 -w1 10.31.0.6 &> /dev/null && nc -z 10.31.0.6 "$PROXY_PORT" &>/dev/null; then
    PROXY_HOST="10.31.0.6"
  elif command -v powershell.exe &>/dev/null; then
    PROXY_HOST="$(powershell.exe -NoProfile -Command "(Get-NetIPAddress -InterfaceAlias WLAN -AddressFamily IPv4).IPAddress | Write-Host -NoNewLine")"
  elif [ -f "/mnt/c/WINDOWS/System32/WindowsPowerShell/v1.0/powershell.exe" ]; then
    PS="/mnt/c/WINDOWS/System32/WindowsPowerShell/v1.0/powershell.exe"
    PROXY_HOST="$($PS -NoProfile -Command "(Get-NetIPAddress -InterfaceAlias WLAN -AddressFamily IPv4).IPAddress | Write-Host -NoNewLine")"
  fi

  export http_proxy="${PROXY_PROTOCOL}://${PROXY_HOST}:${PROXY_PORT}"
fi

export https_proxy="$http_proxy"
export all_proxy="$http_proxy"
export FTP_PROXY="$http_proxy"
export RSYNC_PROXY="$http_proxy"

PROXY_ENVS=({https,http,all}_proxy {FTP,RSYNC}_PROXY)
SSH_CMDS=(ssh sftp scp slogin ssh-copy-id)

# Detect WSL once; used to skip the nc-based ProxyCommand both for git and for
# interactive ssh below.
if [ -n "${WSL_DISTRO_NAME:-}" ] || grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null; then
  IS_WSL=1
else
  IS_WSL=
fi

# WSL already tunnels SSH through the Windows host's networking, so the nc-based
# ProxyCommand isn't needed (and breaks) there. Only route git's SSH through gfw
# outside WSL.
if [ -z "$IS_WSL" ]; then
  export GIT_SSH_COMMAND="gfw ssh"
  PROXY_ENVS+=(GIT_SSH_COMMAND)
fi

function cmd_on() {
  local v
  echo -n export
  for v in "${PROXY_ENVS[@]}"; do
    echo -n " $v='${!v}'"
  done
  echo ";"
  echo -n alias
  for v in "${SSH_CMDS[@]}"; do
    echo -n " $v='gfw $v'"
  done
  echo ";"
  echo '# source <(gfw)'
}

function cmd_off() {
  local v
  echo "unset ${PROXY_ENVS[*]};"
  echo "unalias ${SSH_CMDS[*]};"
  echo '# source <(gfw off)'
}

GFW_CMD="${1:-on}"
case "$GFW_CMD" in
on)
  cmd_on
  ;;
off)
  cmd_off
  ;;
sudo)
  shift
  IFS=,
  exec sudo "${BASH_SOURCE[0]}" "$@"
  ;;
ssh-proxy-command)
  PROXY_TYPE=
  if [[ "$OSTYPE" == "linux"* ]]; then
    case "$http_proxy" in
    socks://* | socks5://*)
      PROXY_TYPE="-X 5"
      ;;
    socks4://* | socks4a://*)
      PROXY_TYPE="-X 4"
      ;;
    *)
      PROXY_TYPE="-X connect"
      ;;
    esac
  fi
  PROXY_NETLOC="${http_proxy#*://}"

  shift
  exec nc $PROXY_TYPE -x "${http_proxy#*://}" "$@"
  ;;
ssh | sftp | scp | slogin | ssh-copy-id)
  shift
  # In WSL the (Windows) OpenSSH client can't launch the WSL ProxyCommand
  # (CreateProcessW error:2), and networking is already tunneled through the
  # Windows host, so run the command directly without the nc ProxyCommand.
  if [ -n "$IS_WSL" ]; then
    exec "$GFW_CMD" "$@"
  fi
  exec "$GFW_CMD" -o ProxyCommand='gfw ssh-proxy-command %h %p' -o Compression=yes "$@"
  ;;
*)
  exec "$@"
  ;;
esac
