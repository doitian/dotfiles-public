#!/usr/bin/env bash
# Copy text using Ansi OSC52 escaping sequence on supported terminals.
set -e
set -u
[ -n "${DEBUG:-}" ] && set -x || true

text="$(
  cat
  printf .
)"
text="${text%.}"

if [ -n "${TMUX:-}" ] && printf %s "$text" | tmux load-buffer -w - 2>/dev/null; then
  exit 0
fi

encoded="$(printf %s "$text" | base64 | tr -d '\n')"
if [ -n "${TMUX:-}" ]; then
  # tmux before 3.2 has no load-buffer -w, but still allows passthrough.
  printf '\033Ptmux;\033\033]52;c;%s\007\033\\' "$encoded"
else
  printf '\033]52;c;%s\007' "$encoded"
fi
