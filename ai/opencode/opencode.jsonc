{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "readwise": {
      "type": "remote",
      "url": "https://mcp2.readwise.io/mcp",
      "enabled": false
    },
    "spiral": {
      "type": "remote",
      "url": "https://api.writewithspiral.com/mcp/",
      "enabled": false
    },
    "grafana": {
      "type": "local",
      "command": ["bunx", "mcp-grafana"],
      "enabled": false
    }
  }
}
