{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "grafana": {
        "type": "local",
        "command": ["uvx", "mcp-grafana"],
        "disabled": true,
      },
      "portal": {
        "type": "remote",
