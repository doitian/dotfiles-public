# Light Kitty/Latte window decorations with a dark Waybar/Macchiato taskbar.
# #6f5d8e is 50% Waybar mauve (#c6a0f6) over crust (#181926).
ThemeDescription="iPad Latte — light windows, dark bar"
Look="flat"
Gradients=""
TitleButtonsSupported="xmis"
RolloverButtonsSupported=1
ShowMenuButtonIcon=0
TitleBarJustify=0
TitleBarHorzOffset=8
TitleBarVertOffset=0
DlgBorderSizeX=2
DlgBorderSizeY=2
TaskBarClockLeds=0
TrayDrawBevel=0

ColorNormalBorder="#8e8bb6"
ColorActiveBorder="#c6a0f6"
ColorNormalTitleBar="#e6e9ef"
ColorActiveTitleBar="#e6e9ef"
ColorNormalTitleBarText="#7c7f93"
ColorActiveTitleBarText="#4c4f69"
ColorNormalTitleBarShadow=""
ColorActiveTitleBarShadow=""
ColorNormalTitleButton="#e6e9ef"
ColorNormalTitleButtonText="#4c4f69"

ColorDefaultTaskBar="#181926"
ColorNormalTaskBarApp="#181926"
ColorNormalTaskBarAppText="#cad3f5"
ColorActiveTaskBarApp="#6f5d8e"
ColorActiveTaskBarAppText="#eff1f5"
ColorMinimizedTaskBarApp="#181926"
ColorMinimizedTaskBarAppText="#8087a2"
ColorInvisibleTaskBarApp="#181926"
ColorInvisibleTaskBarAppText="#8087a2"
ColorNormalWorkspaceButton="#181926"
ColorNormalWorkspaceButtonText="#8087a2"
ColorActiveWorkspaceButton="#363a4f"
ColorActiveWorkspaceButtonText="#8aadf4"
ColorToolButton="#181926"
ColorToolButtonText="#cad3f5"
ColorNormalButton="#e6e9ef"
ColorNormalButtonText="#4c4f69"
ColorActiveButton="#dce0e8"
ColorActiveButtonText="#8839ef"
# Match the desktop background behind the clock text.
ColorClock="#24273a"
ColorClockText="#cad3f5"

ColorNormalMenu="#eff1f5"
ColorNormalMenuItemText="#4c4f69"
ColorActiveMenuItem="#d6c5f3"
ColorActiveMenuItemText="#4c4f69"
ColorDisabledMenuItemText="#9ca0b0"
ColorDisabledMenuItemShadow=""
ColorDialog="#eff1f5"
ColorLabel="#eff1f5"
ColorLabelText="#4c4f69"
ColorInput="#eff1f5"
ColorInputText="#4c4f69"
ColorInputSelection="#8839ef"
ColorInputSelectionText="#eff1f5"
ColorListBox="#eff1f5"
ColorListBoxText="#4c4f69"
ColorListBoxSelection="#8839ef"
ColorListBoxSelectionText="#eff1f5"
ColorToolTip="#eff1f5"
ColorToolTipText="#4c4f69"
ColorQuickSwitch="#eff1f5"
ColorQuickSwitchText="#4c4f69"
ColorQuickSwitchActive="#d6c5f3"
ColorQuickSwitchBorder="#8e8bb6"
ColorMoveSizeStatus="#eff1f5"
ColorMoveSizeStatusText="#4c4f69"
ColorScrollBar="#e6e9ef"
ColorScrollBarSlider="#bcc0cc"
ColorScrollBarButton="#e6e9ef"
ColorScrollBarArrow="#6c6f85"
ColorScrollBarButtonArrow="#6c6f85"
ColorScrollBarInactiveArrow="#9ca0b0"
DesktopBackgroundColor="#24273a"
